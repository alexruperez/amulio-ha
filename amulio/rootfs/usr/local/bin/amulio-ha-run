#!/usr/bin/env bash
set -euo pipefail
umask 077

readonly CONFIG_DIR=/data/config
readonly SECRET_DIR=/data/secrets
readonly OPTIONS_FILE=/data/options.json
readonly AMULE_USER=amule
readonly AMULE_HOME=/var/lib/amule

# su-exec changes uid/gid but retains the parent's environment. aMule needs a
# writable home directory on its first run even when --config-dir is supplied.
export HOME="$AMULE_HOME"
export XDG_CONFIG_HOME="$AMULE_HOME/.config"

log() {
    printf '%s [amulio] %s\n' "$(date -Iseconds)" "$*" >&2
}

on_error() {
    local status=$?
    log "ERROR: startup command failed at line $1 (exit $status)"
    exit "$status"
}

trap 'on_error $LINENO' ERR

option() {
    local value
    value=$(jq -r "$1" "$OPTIONS_FILE")
    if [[ "$value" == "null" ]]; then
        log "ERROR: required option $1 is missing from $OPTIONS_FILE"
        return 1
    fi
    printf '%s\n' "$value"
}

secret() {
    local name=$1 path="$SECRET_DIR/$1"
    ensure_secret "$name"
    cat "$path"
}

supervisor_proxy_sources() {
    python3 - <<'PY'
import ipaddress
import socket

addresses = set()
for result in socket.getaddrinfo("supervisor", None, type=socket.SOCK_STREAM):
    addresses.add(result[4][0])
print(",".join(
    f"{address}/{ipaddress.ip_address(address).max_prefixlen}"
    for address in sorted(addresses, key=ipaddress.ip_address)
))
PY
}

ensure_secret() {
    local name=$1 path="$SECRET_DIR/$1"
    install -d -m 700 "$SECRET_DIR"
    if [[ ! -s "$path" ]]; then
        python3 - "$path" <<'PY'
import pathlib
import secrets
import sys
path = pathlib.Path(sys.argv[1])
path.parent.mkdir(parents=True, exist_ok=True)
path.write_text(secrets.token_urlsafe(48) + "\n")
path.chmod(0o600)
PY
    fi
    chmod 600 "$path"
}

log 'starting runtime bootstrap'
PUBLIC_URL=$(option '.public_url')
TCP_PORT=$(option '.peer_tcp_port')
UDP_PORT=$(option '.peer_udp_port')
PREFERRED_LANGUAGES=$(option '.preferred_languages')
ALLOW_SEASON_PACKS=$(option '.allow_season_packs')
MAX_RESULTS=$(option '.max_results')
MAX_FILE_SIZE_GB=$(option '.max_file_size_gb')
SHOW_STREAM_SIZE=$(option '.show_stream_size')
SHOW_STREAM_SOURCES=$(option '.show_stream_sources')
SHOW_STREAM_LANGUAGE=$(option '.show_stream_language')
SHOW_STREAM_TECHNICAL_DETAILS=$(option '.show_stream_technical_details')
INBOUND_PEER_PORTS_ENABLED=$(option '.inbound_peer_ports_enabled')

case "$PUBLIC_URL" in
    http://*|https://*) ;;
    *) echo 'public_url must be an http(s) URL' >&2; exit 64 ;;
esac

INSTALL_TOKEN=$(secret install_token)
TOKEN_SECRET=$(secret token_secret)
EC_PASSWORD=$(secret amule_ec_password)
API_ADMIN_PASSWORD=$(secret amuleapi_admin_password)
SUPERVISOR_PROXY_SOURCES=$(supervisor_proxy_sources 2>/dev/null || true)
if [[ -z "$SUPERVISOR_PROXY_SOURCES" ]]; then
    # Preserve the portable recovery path when the Supervisor cannot be resolved.
    # These file-only values must never be logged or exposed through app options.
    log 'WARNING: Supervisor hostname did not resolve; using generic admin recovery flow'
    ensure_secret manager_admin_password
    ensure_secret manager_bootstrap_token
fi

log 'preparing persistent directories and aMule configuration'
install -d -o "$AMULE_USER" -g "$AMULE_USER" -m 700 \
    "$CONFIG_DIR" /data/incoming /data/temp /data/amulio "$SECRET_DIR"
if [[ ! -f "$CONFIG_DIR/amule.conf" ]]; then
    log 'initializing aMule default configuration'
    # The first foreground invocation writes the default config, then exits
    # because EC is not configured yet. Its non-zero status is expected only
    # while bootstrapping; require the generated file before continuing.
    su-exec "$AMULE_USER" amuled -c "$CONFIG_DIR" -o -i \
        >"$CONFIG_DIR/initialization.log" 2>&1 || true
    if [[ ! -s "$CONFIG_DIR/amule.conf" ]]; then
        log 'ERROR: aMule did not create amule.conf; see /data/config/initialization.log'
        tail -n 40 "$CONFIG_DIR/initialization.log" >&2 || true
        exit 1
    fi
fi

EC_PASSWORD_MD5=$(printf '%s' "$EC_PASSWORD" | md5sum | cut -d' ' -f1 | tr 'a-f' 'A-F')
su-exec "$AMULE_USER" python3 - "$CONFIG_DIR/amule.conf" "$EC_PASSWORD_MD5" "$TCP_PORT" "$UDP_PORT" <<'PY'
import re
import sys

path, password, tcp_port, udp_port = sys.argv[1:]
content = open(path).read()
for key, value in (
    ("AcceptExternalConnections", "1"),
    ("TCPPort", tcp_port),
    ("UDPPort", udp_port),
    ("ECPort", "4712"),
    ("ECPassword", password),
    ("IncomingDir", "/data/incoming"),
    ("TempDir", "/data/temp"),
):
    if re.search(rf"^{key}=.*$", content, flags=re.MULTILINE):
        content = re.sub(rf"^{key}=.*$", f"{key}={value}", content, flags=re.MULTILINE)
    else:
        content += f"\n{key}={value}\n"
open(path, "w").write(content)
PY

log 'configuring the private aMule REST API'
su-exec "$AMULE_USER" amuleapi --config-dir="$CONFIG_DIR" --set-admin-pass="$API_ADMIN_PASSWORD"
timeout 3 su-exec "$AMULE_USER" amuleapi --config-dir="$CONFIG_DIR" --password="$EC_PASSWORD" \
    --port=4712 --http-port=4713 >/dev/null 2>&1 || true
if [[ ! -s "$CONFIG_DIR/amuleapi.conf" ]]; then
    log 'ERROR: amuleapi did not create amuleapi.conf'
    exit 1
fi
su-exec "$AMULE_USER" python3 - "$CONFIG_DIR/amuleapi.conf" <<'PY'
import re
import sys

path = sys.argv[1]
content = open(path).read()
content = re.sub(r"^BindAddress=.*$", "BindAddress=127.0.0.1", content, flags=re.MULTILINE)
content = re.sub(r"^Port=.*$", "Port=4713", content, count=1, flags=re.MULTILINE)
open(path, "w").write(content)
PY
chown "$AMULE_USER:$AMULE_USER" "$CONFIG_DIR/amule.conf" "$CONFIG_DIR/amuleapi.conf"
chmod 600 "$CONFIG_DIR/amule.conf" "$CONFIG_DIR/amuleapi.conf"

cat >/run/amulio.env <<EOF
AMULIO_PUBLIC_URL=$PUBLIC_URL
AMULIO_INSTALL_TOKEN=$INSTALL_TOKEN
AMULIO_TOKEN_SECRET=$TOKEN_SECRET
AMULIO_TRUSTED_INGRESS_PROXY_SOURCES=$SUPERVISOR_PROXY_SOURCES
AMULE_API_BASE_URL=http://127.0.0.1:4713/api/v0
AMULE_API_ADMIN_PASSWORD_FILE=$SECRET_DIR/amuleapi_admin_password
AMULIO_ALLOWED_MEDIA_ROOTS=/data/incoming
AMULIO_DATABASE_PATH=/data/amulio/amulio.sqlite3
AMULIO_PREFERRED_LANGUAGES=$PREFERRED_LANGUAGES
AMULIO_ALLOW_SEASON_PACKS=$ALLOW_SEASON_PACKS
AMULIO_DEFAULT_RESULT_LIMIT=$MAX_RESULTS
AMULIO_DEFAULT_MAX_SIZE_GB=$MAX_FILE_SIZE_GB
AMULIO_DEFAULT_SHOW_STREAM_SIZE=$SHOW_STREAM_SIZE
AMULIO_DEFAULT_SHOW_STREAM_SOURCES=$SHOW_STREAM_SOURCES
AMULIO_DEFAULT_SHOW_STREAM_LANGUAGE=$SHOW_STREAM_LANGUAGE
AMULIO_DEFAULT_SHOW_STREAM_TECHNICAL_DETAILS=$SHOW_STREAM_TECHNICAL_DETAILS
AMULIO_INBOUND_PEER_PORTS_ENABLED=$INBOUND_PEER_PORTS_ENABLED
EOF
if [[ -z "$SUPERVISOR_PROXY_SOURCES" ]]; then
    cat >>/run/amulio.env <<EOF
AMULIO_ADMIN_PASSWORD_FILE=$SECRET_DIR/manager_admin_password
AMULIO_ADMIN_BOOTSTRAP_TOKEN_FILE=$SECRET_DIR/manager_bootstrap_token
EOF
fi
chmod 600 /run/amulio.env

cleanup() {
    kill "${AMULIO_PID:-}" "${AMULEAPI_PID:-}" "${AMULED_PID:-}" 2>/dev/null || true
    wait "${AMULIO_PID:-}" "${AMULEAPI_PID:-}" "${AMULED_PID:-}" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

su-exec "$AMULE_USER" amuled -c "$CONFIG_DIR" -o >"$CONFIG_DIR/amuled.log" 2>&1 &
AMULED_PID=$!
log 'waiting for aMule EC on 127.0.0.1:4712'
for _ in $(seq 1 30); do
    if (echo >/dev/tcp/127.0.0.1/4712) 2>/dev/null; then
        break
    fi
    sleep 1
done
if ! (echo >/dev/tcp/127.0.0.1/4712) 2>/dev/null; then
    log 'ERROR: amuled EC service did not become ready; see /data/config/amuled.log'
    exit 1
fi

log 'starting loopback-only amuleapi on 127.0.0.1:4713'
su-exec "$AMULE_USER" amuleapi --config-dir="$CONFIG_DIR" --host=127.0.0.1 --port=4712 \
    --password="$EC_PASSWORD" --http-port=4713 --bind=127.0.0.1 --no-log-file &
AMULEAPI_PID=$!

set -a
# shellcheck disable=SC1091
source /run/amulio.env
set +a
log 'starting aMulio HTTP API on 0.0.0.0:8000'
uvicorn amulio.app:app --host 0.0.0.0 --port 8000 &
AMULIO_PID=$!

wait -n "$AMULED_PID" "$AMULEAPI_PID" "$AMULIO_PID"
echo 'aMulio runtime process stopped unexpectedly' >&2
exit 1
